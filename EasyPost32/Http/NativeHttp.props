<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <EasyPostRoot>$(MSBuildThisFileDirectory)..\</EasyPostRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == '' and '$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)\</VcpkgRoot>
    <VcpkgRoot Condition="'$(VcpkgRoot)' == ''">$(VCInstallDir)vcpkg\</VcpkgRoot>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgManifestRoot>$(EasyPostRoot)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(EasyPostRoot)build\vcpkg_installed\</VcpkgInstalledDir>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <VcpkgAutoLink>false</VcpkgAutoLink>
    <OutDir>$(EasyPostRoot)x64\$(Configuration)\</OutDir>
    <IntDir>$(EasyPostRoot)build\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <Import Project="$(VcpkgRoot)scripts\buildsystems\msbuild\vcpkg.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_CONSOLE;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
